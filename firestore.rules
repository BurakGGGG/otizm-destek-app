rules_version = '2';

// Cloud Firestore — istemciye kapalı.
//
// Kaynak doğruluk Spring backend + Postgres; bu üründe Firestore
// kullanılmıyor. Kural dosyası yine de tutuluyor: Firestore API'si bir gün
// (ör. konsolda başka bir Firebase ürünü açılırken) etkinleştirilirse
// "test modu" varsayılanı veritabanını 30 gün boyunca herkese açar.
//
// Yayınlamak için:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
